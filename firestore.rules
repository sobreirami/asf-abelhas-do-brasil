/**
 * REGRAS DE SEGURANÇA DO FIRESTORE
 * 
 * Cole estas regras no Firebase Console > Firestore Database > Rules
 * 
 * Estas regras permitem:
 * - Leitura pública de todas as coleções (qualquer usuário pode ler)
 * - Escrita apenas para usuários autenticados (se você adicionar autenticação)
 * - A coleção 'pushTokens' pode ser escrita por qualquer um (para registrar tokens)
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para a coleção 'species'
    match /species/{speciesId} {
      // Qualquer um pode ler as espécies
      allow read: if true;
      
      // Apenas usuários autenticados podem escrever (adicionar/editar/deletar)
      // Para adicionar auth, descomente: allow write: if request.auth != null;
      allow write: if false; // Por enquanto, ninguém pode escrever via app
    }
    
    // Regras para a coleção 'pushTokens'
    match /pushTokens/{tokenId} {
      // Qualquer um pode ler
      allow read: if true;
      
      // Qualquer um pode criar/atualizar tokens
      // (necessário para registrar dispositivos para notificações)
      allow create, update: if true;
      
      // Apenas o proprietário pode deletar (se você adicionar auth)
      allow delete: if false;
    }
    
    // Bloqueia acesso a outras coleções não especificadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/**
 * ÍNDICES RECOMENDADOS PARA O FIRESTORE
 * 
 * Crie estes índices compostos no Firebase Console > Firestore Database > Indexes
 * para melhorar a performance das queries:
 * 
 * 1. Coleção: species
 *    - Campo: regioes (Arrays)
 *    - Campo: nomePopular (Ascending)
 *    - Scope da query: Collection
 * 
 * 2. Coleção: species
 *    - Campo: comportamento (Ascending)
 *    - Campo: nomePopular (Ascending)
 *    - Scope da query: Collection
 * 
 * Os índices serão criados automaticamente quando você executar as queries pela primeira vez.
 * O Firebase mostrará um link no console do erro para criar o índice necessário.
 */
